# PaddleOCR local HTTP service - optional service
# Build for linux/amd64 on Apple Silicon:
#   docker buildx build --platform linux/amd64 -f Dockerfile.ocr -t knowledge-base-ocr:amd64 .
#
# China network: use a reachable base-image mirror by default.

ARG BASE_IMAGE=python:3.11-slim

FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Fonts for Chinese recognition + libs required by PaddlePaddle/OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    fonts-noto-cjk \
    libgomp1 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

ARG PIP_INDEX_URL=https://pypi.org/simple

COPY ocr_service/requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt --index-url ${PIP_INDEX_URL}

COPY ocr_service/app.py ./app.py

# PaddleOCR model cache
RUN mkdir -p /root/.paddlex

EXPOSE 8521

CMD ["python", "app.py"]
